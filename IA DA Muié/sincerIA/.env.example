GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
VENICE_API_KEY=
OLLAMA_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

BACKEND_URL=http://localhost:8000

# Modelos de visão existentes na configuração atual.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_PRIMARY_TIMEOUT_SECONDS=15
GEMINI_FALLBACK_TIMEOUT_SECONDS=25
ORCHESTRATOR_TIMEOUT_SECONDS=45
ORCHESTRATOR_VISION_TIMEOUT_SECONDS=45

# Persistência local. Em produção, indique caminhos persistentes.
DATABASE_PATH=data/sincerIA.db
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO
